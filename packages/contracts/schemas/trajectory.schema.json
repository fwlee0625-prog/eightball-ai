{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eightball AI Shot Trajectory",
  "description": "One observed or synthetic shot trajectory. Timestamps are nanoseconds relative to shot start; actual timestamps, not nominal FPS, define playback timing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trajectory_id",
    "match_id",
    "rack_id",
    "shot_id",
    "table_id",
    "state_version",
    "source",
    "timebase",
    "coordinate_frame",
    "table_geometry",
    "frames",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "rack_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "table_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_unit",
        "timestamp_origin",
        "nominal_fps"
      ],
      "properties": {
        "timestamp_unit": {
          "const": "ns"
        },
        "timestamp_origin": {
          "const": "shot_start"
        },
        "nominal_fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "origin",
        "x_axis",
        "y_axis",
        "positive_x",
        "positive_y",
        "orientation_status"
      ],
      "properties": {
        "units": {
          "const": "mm"
        },
        "origin": {
          "const": "table_center"
        },
        "x_axis": {
          "const": "table_width"
        },
        "y_axis": {
          "const": "table_length"
        },
        "positive_x": {
          "const": "inherited_from_vision"
        },
        "positive_y": {
          "const": "inherited_from_vision"
        },
        "orientation_status": {
          "const": "provisional"
        }
      }
    },
    "table_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_length_mm",
        "active_width_mm"
      ],
      "properties": {
        "active_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "active_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_index",
          "timestamp_ns",
          "balls"
        ],
        "properties": {
          "frame_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timestamp_ns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "balls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "x_mm",
                "y_mm"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 15
                },
                "x_mm": {
                  "type": "number"
                },
                "y_mm": {
                  "type": "number"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "project-provided"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
